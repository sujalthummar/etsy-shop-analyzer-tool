# --- Etsy Open API v3 ---
# Get these from https://www.etsy.com/developers/your-apps
# As of Feb 2026, Etsy requires BOTH values combined in every request.
ETSY_KEYSTRING=your_etsy_keystring_here
ETSY_SHARED_SECRET=your_etsy_shared_secret_here

# --- Supabase ---
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# --- Optional: protects /api/cron from being called by randoms ---
CRON_SECRET=pick_any_random_string
